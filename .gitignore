# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage

# next.js & build output
/.next/
/out/
/build/

# misc & OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem
*.key
*.cert
*.crt

# ide & editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (whitelist .env.example for public onboarding)
.env*
!.env.example

# vercel deployment artifacts
.vercel

# typescript cache & type declarations
*.tsbuildinfo
next-env.d.ts

# local database temporary files, dumps & backups
/supabase/.temp/
/supabase/backups/
/supabase/.branches/
*.dump
*.sql.bak

# internal developer temporary review and scratch files
*.scratch.*
/scratch/

# internal audit tracking files (ignored from git)
/docs/audits/
